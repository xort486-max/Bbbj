<?xml version="1.0" encoding="utf-8"?>
<!-- 클라우드 백업·기기 이전에서 앱 데이터를 제외한다. 암호화된 토큰은 Keystore 키가 기기 밖으로 나가지 않아 복원해도 쓸 수 없기 때문. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
