# JARVIS backend 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 대상입니다. 실제 키를 절대 커밋하지 마세요.

# ── 앱 ↔ 백엔드 인증 ──────────────────────────────────────────
# 긴 무작위 문자열. 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# iOS 앱 설정 화면의 "앱 인증 토큰"에 같은 값을 입력합니다.
JARVIS_APP_TOKEN=

# ── NVIDIA — 대화 엔진 ────────────────────────────────────────
# 키 발급: https://build.nvidia.com  (Settings > API Keys)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# API Catalog에서 사용할 채팅 모델 ID (예: 모델 페이지의 "model" 값). PHASE 2에서 함께 선택합니다.
NVIDIA_MODEL=

# ── Google — 검색 엔진 ────────────────────────────────────────
# custom_search    : Custom Search JSON API (신규 고객 접수 중단, 2027-01-01 종료 예정 — 기존 사용자만)
# vertex_ai_search : Vertex AI Search (지정한 사이트/데이터 검색)
# gemini_grounding : Gemini API "Grounding with Google Search" (웹 전체 검색 근거 + 출처)
GOOGLE_SEARCH_PROVIDER=
GOOGLE_API_KEY=
# custom_search 전용
GOOGLE_CSE_ID=
# vertex_ai_search 전용
GOOGLE_CLOUD_PROJECT=
VERTEX_SEARCH_ENGINE_ID=

# ── Claude — AI 두뇌 · 에이전트 ───────────────────────────────
# 키 발급: https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
