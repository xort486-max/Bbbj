# JARVIS backend 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  copy .env.example .env  (Mac/Linux: cp)
# .env 는 .gitignore 대상입니다. 실제 키를 절대 커밋하지 마세요.

# ── 앱 ↔ 백엔드 인증 ──────────────────────────────────────────
# 긴 무작위 문자열. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 앱 설정 화면의 "앱 인증 토큰"에 같은 값을 입력합니다.
JARVIS_APP_TOKEN=

# ── NVIDIA — 대화 엔진 ────────────────────────────────────────
# 키 발급: https://build.nvidia.com  (API Keys)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 기본값: nvidia/nemotron-3.5-lightning-30b-a3b (2026-11 실제 호출로 확인, 한국어 응답 0.3~1초)
# 사용 가능한 모델 목록: GET https://integrate.api.nvidia.com/v1/models  (지원 종료 모델은 410 응답)
NVIDIA_MODEL=
NVIDIA_MAX_TOKENS=2048
# 모델 추론 모드: false(빠른 대화, 기본) / true / auto(옵션 미전송 — Nemotron 외 모델 사용 시 권장)
NVIDIA_ENABLE_THINKING=false

# ── Google — 검색 엔진 (Gemini API · Grounding with Google Search) ──
# 키 발급: https://aistudio.google.com  (Get API key)
# 주의: 근거 결과는 캐시·수정·다른 AI 분석 금지, 검색 제안과 함께 표시 (Gemini API 추가 약관)
GOOGLE_SEARCH_PROVIDER=gemini_grounding
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# ── Claude — AI 두뇌 · 에이전트 (agent / research 경로) ─────────
# 키 발급: https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 추론 깊이: low / medium(기본) / high / xhigh / max — 높을수록 정확하지만 느리고 비쌈
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_WEB_SEARCH_MAX_USES=5

# ── 사용량 · 한도 ─────────────────────────────────────────────
JARVIS_USAGE_DB=jarvis_usage.sqlite3
JARVIS_TIMEZONE=Asia/Seoul
# 엔진별 하루 요청 한도 (0 = 제한 없음). 초과 시 research→Google, agent→NVIDIA로 대체 처리
DAILY_LIMIT_NVIDIA=0
DAILY_LIMIT_GOOGLE=0
DAILY_LIMIT_CLAUDE=50
# Claude 응답 캐시 유지 시간(초). Google 검색 결과는 약관상 캐시하지 않음
RESPONSE_CACHE_TTL_SECONDS=600
